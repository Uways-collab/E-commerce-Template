{
  "name": "product-pro-hub",
  "version": "1.0.0",
  "description": "Product Pro Hub — a production-oriented, fully configurable e-commerce template (Next.js + SQLite).",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "rm -f data/store.db data/store.db-wal data/store.db-shm && node scripts/seed.mjs",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uways-collab/E-commerce-Template.git"
  },
