  "bugs": {
    "url": "https://github.com/Uways-collab/E-commerce-Template/issues"
  },
  "homepage": "https://github.com/Uways-collab/E-commerce-Template#readme",
  "private": "true",
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "15.5.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
