# ---------------------------------------------------------------------------
# Product Pro Hub — environment configuration
# Copy to .env.local and fill in the values you need.
# ---------------------------------------------------------------------------

# Signing secret for customer/admin session cookies.
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Absolute public URL of the store (used for canonical URLs, sitemap, redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite database file (defaults to ./data/store.db)
DATABASE_PATH=./data/store.db

# ---------------------------------------------------------------------------
# Payment providers — secrets are read on the server only, never exposed to the
# browser. Leave blank to disable a provider; the storefront then falls back to
# bank transfer / cash on delivery (whatever the admin enables in Store Settings).
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Seed credentials for the first administrator (npm run db:seed)
SEED_ADMIN_EMAIL=admin@productprohub.com
SEED_ADMIN_PASSWORD=Admin!2345
